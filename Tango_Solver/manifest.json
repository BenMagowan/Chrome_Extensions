{
  "manifest_version": 3,
  "name": "Tango Puzzle Solver",
  "version": "1.4.3",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "description": "Solves the daily LinkedIn Tango puzzle for you. Fills in every sun and moon in one click, or on its own when the board loads.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Solve Tango"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/games/tango*",
        "*://*.linkedin.com/games/view/tango*"
      ],
      "js": ["injected.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": ["scripting", "storage"],
  "host_permissions": ["*://*.linkedin.com/games/*"]
}
