{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "2.0.0",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "description": "__MSG_extDescription__",
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/games/",
        "*://*.linkedin.com/games/?*"
      ],
      "js": [
        "games.js",
        "hub.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.linkedin.com/games/zip*",
        "*://*.linkedin.com/games/view/zip*"
      ],
      "js": [
        "games.js",
        "games/zip/injected.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.linkedin.com/games/queens*",
        "*://*.linkedin.com/games/view/queens*"
      ],
      "js": [
        "games.js",
        "games/queens/injected.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.linkedin.com/games/tango*",
        "*://*.linkedin.com/games/view/tango*"
      ],
      "js": [
        "games.js",
        "games/tango/injected.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.linkedin.com/games/mini-sudoku*",
        "*://*.linkedin.com/games/view/mini-sudoku*"
      ],
      "js": [
        "games.js",
        "games/sudoku/injected.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.linkedin.com/games/patches*",
        "*://*.linkedin.com/games/view/patches*"
      ],
      "js": [
        "games.js",
        "games/patches/injected.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.linkedin.com/games/sumbreak*",
        "*://*.linkedin.com/games/view/sumbreak*"
      ],
      "js": [
        "games.js",
        "games/sumbreak/injected.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.linkedin.com/games/*"
  ]
}
