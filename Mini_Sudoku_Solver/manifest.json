{
  "manifest_version": 3,
  "name": "Mini Sudoku Puzzle Solver",
  "version": "1.3.1",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "description": "Automatically parses and solves the LinkedIn game Mini Sudoku.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Solve Mini Sudoku"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/games/mini-sudoku*",
        "*://*.linkedin.com/games/view/mini-sudoku*"
      ],
      "js": ["injected.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": ["scripting", "storage"],
  "host_permissions": ["*://*.linkedin.com/*"]
}
